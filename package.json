{
	"name": "kato-dashboard",
	"private": true,
	"version": "1.5.0",
	"description": "High-density wallboard monitoring dashboard for desktop and TV screens with zero scroll",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"keywords": [
		"monitoring",
		"dashboard",
		"wallboard",
		"svelte",
		"sveltekit",
		"high-density",
		"realtime",
		"sse",
		"uptime"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test 'src/**/*.test.ts'",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitepress": "^2.0.0-alpha.20"
	},
	"dependencies": {
		"dotenv": "^18.0.9",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.1.1"
	}
}
